# AI provider credentials (deployment scripts copy these into Kubernetes Secrets)
JEV_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Solace MQTT endpoint. Leave blank for local in-process demo mode.
SOLACE_HOST=
SOLACE_VPN=default
SOLACE_USERNAME=
SOLACE_PASSWORD=

# Runtime
APP_ENV=development
PORT=8080
SCENARIO_TICK_SECONDS=1.0

# Local operations demo: deterministic by default; opt in to external calls.
ENABLE_EXTERNAL_PROVIDERS=false
INCIDENT_STORE_PATH=.runtime/incidents.sqlite3
INVESTIGATION_TIMEOUT_SECONDS=8
